# Shopify App Credentials
SHOPIFY_API_KEY=your_api_key_here
SHOPIFY_API_SECRET=your_api_secret_here
SHOPIFY_ACCESS_TOKEN=your_access_token_here
SHOP_NAME=your-shop-name.myshopify.com

# App Configuration
PORT=3000
HOST=https://your-app-url.com

# Metal Prices Metaobject ID (will be created during setup)
METAL_PRICES_METAOBJECT_ID=

# Stone Prices Metaobject ID (will be created during setup)
STONE_PRICES_METAOBJECT_ID=

# Optional embedded messaging. Keep disabled until staging is configured.
MESSAGING_EMBEDDED_ENABLED=false
MESSAGING_AUTO_MIGRATE=false
MESSAGING_DATABASE_PROVIDER=mongodb
MONGODB_URI=
MONGODB_DATABASE=bhima_messaging_staging
# Optional PostgreSQL fallback when MESSAGING_DATABASE_PROVIDER=postgres.
DATABASE_URL=
SHOPIFY_SHOP=
SHOPIFY_ADMIN_ACCESS_TOKEN=
SHOPIFY_WEBHOOK_SECRET=
TELINFY_API_KEY=
FEATURE_ORDER_SMS=false
FEATURE_TRACKING_SMS=false
MESSAGING_DRY_RUN=true
ALLOW_TEST_ORDERS=false
MESSAGE_RECIPIENT_ALLOWLIST=
WORKER_POLL_MS=600000
SMS_CONFIRMED_STALE_CREDIT_EXPIRY=
