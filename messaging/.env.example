# Copy to messaging/.env. Secrets belong only in this ignored file / host secrets.
PORT=3010
MESSAGING_DATABASE_PROVIDER=mongodb
MONGODB_URI=
MONGODB_DATABASE=bhima_messaging_staging
# Optional PostgreSQL fallback when MESSAGING_DATABASE_PROVIDER=postgres.
DATABASE_URL=
SHOPIFY_SHOP=f0a486-rn.myshopify.com
SHOPIFY_API_VERSION=2026-10
SHOPIFY_ADMIN_ACCESS_TOKEN=
SHOPIFY_WEBHOOK_SECRET=
TELINFY_BASE_URL=https://hub.telinfy.com/unified/developer
TELINFY_API_KEY=
SMS_SENDER=BIMJWL
SMS_OTP_TEMPLATE_ID=1777179214877098475
SMS_ORDER_TEMPLATE_ID=1777179214792762931
SMS_TRACKING_TEMPLATE_ID=1777179214853851012
# Optional exact timestamp exception after confirmed real delivery despite that
# returned expiry. A different expired value still blocks sending. See README.
SMS_CONFIRMED_STALE_CREDIT_EXPIRY=

# Start with both features OFF and dry-run ON.
FEATURE_ORDER_SMS=false
FEATURE_TRACKING_SMS=false
MESSAGING_DRY_RUN=true
# Optional staging restriction: comma-separated Indian test mobile numbers.
MESSAGE_RECIPIENT_ALLOWLIST=
ALLOW_TEST_ORDERS=false
PROVIDER_TIMEOUT_MS=10000
WORKER_POLL_MS=2000
WORKER_LEASE_SECONDS=120
MAX_ATTEMPTS=3
